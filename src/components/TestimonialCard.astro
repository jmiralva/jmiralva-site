---
import type { Testimonial } from '../data/testimonials';

interface Props extends Testimonial {
  /** "lead" is the big opening quote; "standard" is used in the quote grids */
  variant?: 'lead' | 'standard';
}

const { quote, name, nameUrl, role, variant = 'standard' } = Astro.props;
---

<figure class={variant === 'lead' ? 'lead-quote' : 'quote'}>
  <blockquote>
    <p>{quote}</p>
  </blockquote>
  <figcaption class="byline">
    <a class="ink-link" href={nameUrl} target="_blank" rel="noopener noreferrer">{name}</a><br>
    {role}
  </figcaption>
</figure>
