---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  url: string;
  image: ImageMetadata;
  altText: string;
  techLabel?: string;
  techStack: string;
  index: number;
}

const {
  title,
  description,
  url,
  image,
  altText,
  techLabel = "How it's built",
  techStack,
  index
} = Astro.props;

const imageOnBottom = index % 2 === 1;  // Odd cards: image on bottom
---

<div class={`project-card ${imageOnBottom ? 'image-bottom' : 'image-top'}`} data-href={url}>
  <div class="project-image">
    <Image src={image} alt={altText} width={800} height={600} />
  </div>
  <div class="project-content">
    <h3 class="project-title">{title}</h3>
    <p class="project-description" set:html={description}></p>
    <div class="project-tech">
      <span class="tech-label">{techLabel}</span>
      <p class="tech-stack" set:html={techStack}></p>
    </div>
  </div>
</div>
