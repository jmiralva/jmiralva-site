---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<BaseLayout
  title="Projects | Jorge Mir Alvarez"
  description="Side projects and tools built by Jorge Mir Alvarez."
  canonicalURL="https://jmiralva.me/projects"
>
  <header class="page-head">
    <div class="wrap">
      <h1 class="page-title">Projects</h1>
      <p class="page-intro">Things I've built for funsies in my spare time.</p>
    </div>
  </header>

  <div class="wrap page-body">
    <ul class="project-list">
      {projects.map((project) => (
        <li><ProjectCard {...project} /></li>
      ))}
    </ul>
  </div>
</BaseLayout>
