---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Jorge Mir Alvarez | Product Manager"
  description="Jorge Mir Alvarez is a Spanish-born product manager based in Chicago, helping organizations deliver digital product experiences that delight users and drive results."
  canonicalURL="https://jmiralva.me/"
>
  <!-- Hero Section -->
  <main class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <h1>Hi, I'm <span class="highlight">Jorge</span></h1>
        <p class="hero-subtitle">I'm a Spanish-born product manager based in Chicago</p>
        <p class="hero-description">I help organizations big and small identify opportunities to improve their business and deliver digital product experiences that delight users and drive results.</p>
        <p class="hero-beliefs">I'm a firm believer that collaboration is the best path forward, software is awesome, and ice cream is the best dessert.</p>
      </div>
      <div class="hero-image">
        <img src="/headshot.jpg" alt="Jorge Mir Alvarez" />
      </div>
    </div>
  </main>
</BaseLayout>
