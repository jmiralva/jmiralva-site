---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getSortedPosts } from '../../utils/posts';

const posts = await getSortedPosts();

// Group posts by year, newest first
const years = [...new Set(posts.map((post) => post.data.pubDate.getUTCFullYear()))];
const postsByYear = years.map((year) => ({
  year,
  posts: posts.filter((post) => post.data.pubDate.getUTCFullYear() === year),
}));
---

<BaseLayout
  title="Blog | Jorge Mir Alvarez"
  description="Thoughts and musings on product management, technology, and more."
  canonicalURL="https://jmiralva.me/blog/"
>
  <header class="page-head">
    <div class="wrap">
      <h1 class="page-title">Blog</h1>
      <p class="page-intro">Infrequent reflections on software, life, culture, and whatever is on my mind.</p>
    </div>
  </header>

  <div class="wrap page-body">
    {posts.length === 0 ? (
      <p>No posts yet. Check back soon!</p>
    ) : (
      postsByYear.map(({ year, posts }) => (
        <section class="year-group split" aria-labelledby={`year-${year}`}>
          <h2 class="year-title" id={`year-${year}`}>{year}</h2>
          <PostList posts={posts} />
        </section>
      ))
    )}
  </div>
</BaseLayout>
