---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { leadTestimonial, otherTestimonials } from '../data/testimonials';
---

<BaseLayout
  title="Testimonials | Jorge Mir Alvarez"
  description="What colleagues and collaborators say about working with Jorge Mir Alvarez."
  canonicalURL="https://jmiralva.me/testimonials"
>
  <header class="page-head">
    <div class="wrap">
      <h1 class="page-title">Testimonials</h1>
      <p class="page-intro">Nice things people have said about me or what it's like to work with me.</p>
    </div>
  </header>

  <div class="wrap page-body">
    <TestimonialCard {...leadTestimonial} variant="lead" />
    <ul class="quote-grid">
      {otherTestimonials.map((testimonial) => (
        <li><TestimonialCard {...testimonial} /></li>
      ))}
    </ul>
  </div>
</BaseLayout>
