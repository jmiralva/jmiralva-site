---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
}

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

const formattedPubDate = new Date(pubDate).toLocaleDateString('en-us', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate
  ? new Date(updatedDate).toLocaleDateString('en-us', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : undefined;
---

<BaseLayout title={`${title} | Jorge Mir Alvarez`} description={description}>
  <article class="blog-post">
    <header class="blog-post-header">
      <span class="section-label">Blog</span>
      <h1>{title}</h1>
      <div class="blog-post-meta">
        <time datetime={pubDate.toISOString()}>
          {formattedPubDate}
        </time>
        {formattedUpdatedDate && (
          <span class="blog-post-updated">
            (Updated: <time datetime={updatedDate?.toISOString()}>
              {formattedUpdatedDate}
            </time>)
          </span>
        )}
      </div>
    </header>
    {heroImage && (
      <div class="blog-post-hero">
        <img src={heroImage} alt={title} />
      </div>
    )}
    <div class="blog-post-content">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: 800px;
    margin: 0 auto;
    padding: 120px 2rem 4rem;
  }

  .blog-post-header {
    margin-bottom: 2rem;
  }

  .blog-post-header h1 {
    margin-bottom: 1rem;
  }

  .blog-post-meta {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .blog-post-updated {
    margin-left: 1rem;
    font-style: italic;
  }

  .blog-post-hero {
    margin-bottom: 2rem;
    border-radius: 12px;
    overflow: hidden;
  }

  .blog-post-hero img {
    width: 100%;
    height: auto;
    display: block;
  }

  .blog-post-content {
    line-height: 1.8;
  }

  .blog-post-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.75rem;
  }

  .blog-post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.4rem;
  }

  .blog-post-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .blog-post-content :global(a) {
    color: var(--primary);
    text-decoration: underline;
  }

  .blog-post-content :global(a:hover) {
    text-decoration: none;
  }

  .blog-post-content :global(ul),
  .blog-post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .blog-post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .blog-post-content :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid var(--primary);
    background: var(--bg-secondary);
    font-style: italic;
  }

  .blog-post-content :global(code) {
    background: var(--bg-secondary);
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .blog-post-content :global(pre) {
    background: var(--bg-secondary);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .blog-post-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .blog-post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 2rem 0;
  }

  @media (max-width: 768px) {
    .blog-post {
      padding: 100px 1.5rem 3rem;
    }

    .blog-post-content :global(h2) {
      font-size: 1.5rem;
    }

    .blog-post-content :global(h3) {
      font-size: 1.25rem;
    }
  }
</style>
